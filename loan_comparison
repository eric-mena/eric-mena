<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mortgage Refinance Calculator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }
        
        .subtitle {
            opacity: 0.9;
            font-size: 1.1rem;
        }
        
        .main-content {
            display: grid;
            grid-template-columns: 400px 1fr;
            gap: 30px;
            padding: 30px;
        }
        
        .input-panel {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 25px;
        }
        
        .section-title {
            font-size: 1.2rem;
            color: #333;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #667eea;
        }
        
        .input-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-weight: 500;
            font-size: 0.9rem;
        }
        
        input[type="number"], input[type="text"] {
            width: 100%;
            padding: 10px;
            border: 2px solid #e0e0e0;
            border-radius: 5px;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        
        input[type="number"]:focus, input[type="text"]:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .results-panel {
            display: grid;
            gap: 25px;
        }
        
        .comparison-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }
        
        .card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        
        .card-title {
            font-size: 1.1rem;
            color: #667eea;
            margin-bottom: 15px;
            font-weight: 600;
        }
        
        .metric {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .metric-label {
            color: #666;
            font-size: 0.9rem;
        }
        
        .metric-value {
            font-weight: 600;
            color: #333;
        }
        
        .highlight {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px;
            margin-top: 10px;
        }
        
        .savings-summary {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
        }
        
        .big-number {
            font-size: 2.5rem;
            font-weight: bold;
            margin: 10px 0;
        }
        
        .calculate-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.3s;
            margin-top: 20px;
        }
        
        .calculate-btn:hover {
            transform: scale(1.05);
        }
        
        .warning {
            background: #fff3cd;
            border: 1px solid #ffc107;
            color: #856404;
            padding: 10px;
            border-radius: 5px;
            margin-top: 10px;
            font-size: 0.9rem;
        }
        
        .success {
            background: #d4edda;
            border: 1px solid #28a745;
            color: #155724;
            padding: 10px;
            border-radius: 5px;
            margin-top: 10px;
            font-size: 0.9rem;
        }
        
        @media (max-width: 968px) {
            .main-content {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🏠 Mortgage Refinance Calculator</h1>
            <div class="subtitle">Compare refinancing scenarios and find your best option</div>
        </div>
        
        <div class="main-content">
            <div class="input-panel">
                <div class="section-title">Current Loan Details</div>
                
                <div class="input-group">
                    <label for="currentBalance">Current Balance ($)</label>
                    <input type="number" id="currentBalance" value="478635.54" step="0.01">
                </div>
                
                <div class="input-group">
                    <label for="currentRate">Current Interest Rate (%)</label>
                    <input type="number" id="currentRate" value="7.25" step="0.01">
                </div>
                
                <div class="input-group">
                    <label for="currentPayment">Current Monthly Payment ($)</label>
                    <input type="number" id="currentPayment" value="3661.58" step="0.01">
                </div>
                
                <div class="input-group">
                    <label for="remainingYears">Remaining Years</label>
                    <input type="number" id="remainingYears" value="22.5" step="0.5">
                </div>
                
                <div class="section-title" style="margin-top: 30px;">New Loan Options</div>
                
                <div class="input-group">
                    <label for="newRate">New Interest Rate (%)</label>
                    <input type="number" id="newRate" value="5.99" step="0.01">
                </div>
                
                <div class="input-group">
                    <label for="newTerm">New Loan Term (Years)</label>
                    <input type="number" id="newTerm" value="30" step="1">
                </div>
                
                <div class="input-group">
                    <label for="closingCosts">Points/Closing Costs ($)</label>
                    <input type="number" id="closingCosts" value="11000" step="100">
                </div>
                
                <div class="input-group">
                    <label for="extraPayment">Extra Monthly Payment ($)</label>
                    <input type="number" id="extraPayment" value="0" step="10" placeholder="Optional extra principal">
                </div>
                
                <button class="calculate-btn" onclick="calculate()">Calculate Scenarios</button>
            </div>
            
            <div class="results-panel" id="results">
                <div class="savings-summary">
                    <div>Click "Calculate Scenarios" to see your results</div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }
        
        function formatNumber(num) {
            return new Intl.NumberFormat('en-US').format(Math.round(num));
        }
        
        function calculateMonthlyPayment(principal, rate, months) {
            const monthlyRate = rate / 100 / 12;
            if (monthlyRate === 0) return principal / months;
            return principal * (monthlyRate * Math.pow(1 + monthlyRate, months)) / 
                   (Math.pow(1 + monthlyRate, months) - 1);
        }
        
        function calculateLoanDetails(principal, rate, payment, extraPayment = 0) {
            const monthlyRate = rate / 100 / 12;
            let balance = principal;
            let totalPayments = 0;
            let totalInterest = 0;
            let months = 0;
            
            while (balance > 0.01 && months < 600) {
                const interestPayment = balance * monthlyRate;
                const principalPayment = payment + extraPayment - interestPayment;
                
                if (principalPayment > balance) {
                    totalPayments += balance + interestPayment;
                    totalInterest += interestPayment;
                    balance = 0;
                } else {
                    balance -= principalPayment;
                    totalPayments += payment + extraPayment;
                    totalInterest += interestPayment;
                }
                months++;
            }
            
            return {
                months: months,
                totalPayments: totalPayments,
                totalInterest: totalInterest,
                finalPayment: payment + extraPayment
            };
        }
        
        function calculate() {
            // Get input values
            const currentBalance = parseFloat(document.getElementById('currentBalance').value);
            const currentRate = parseFloat(document.getElementById('currentRate').value);
            const currentPayment = parseFloat(document.getElementById('currentPayment').value);
            const remainingYears = parseFloat(document.getElementById('remainingYears').value);
            const newRate = parseFloat(document.getElementById('newRate').value);
            const newTerm = parseFloat(document.getElementById('newTerm').value);
            const closingCosts = parseFloat(document.getElementById('closingCosts').value);
            const extraPayment = parseFloat(document.getElementById('extraPayment').value) || 0;
            
            // Calculate current loan details
            const currentDetails = calculateLoanDetails(currentBalance, currentRate, currentPayment);
            
            // Calculate new loan payment
            const newMonthlyPayment = calculateMonthlyPayment(currentBalance, newRate, newTerm * 12);
            
            // Calculate new loan without extra payments
            const newDetails = calculateLoanDetails(currentBalance, newRate, newMonthlyPayment);
            
            // Calculate new loan with extra payments
            const newDetailsWithExtra = calculateLoanDetails(currentBalance, newRate, newMonthlyPayment, extraPayment);
            
            // Calculate savings
            const monthlySavings = currentPayment - newMonthlyPayment;
            const breakEvenMonths = closingCosts / monthlySavings;
            
            // Calculate scenario with savings applied to principal
            const savingsAsExtra = calculateLoanDetails(currentBalance, newRate, newMonthlyPayment, monthlySavings);
            
            // Build results HTML
            let resultsHTML = `
                <div class="savings-summary">
                    <div>Monthly Payment Savings</div>
                    <div class="big-number">${formatCurrency(monthlySavings)}</div>
                    <div>Break-even: ${Math.round(breakEvenMonths)} months</div>
                </div>
                
                <div class="comparison-cards">
                    <div class="card">
                        <div class="card-title">📊 Current Loan</div>
                        <div class="metric">
                            <span class="metric-label">Monthly Payment</span>
                            <span class="metric-value">${formatCurrency(currentPayment)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Remaining Months</span>
                            <span class="metric-value">${Math.round(currentDetails.months)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Interest</span>
                            <span class="metric-value">${formatCurrency(currentDetails.totalInterest)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Payments</span>
                            <span class="metric-value">${formatCurrency(currentDetails.totalPayments)}</span>
                        </div>
                        <div class="highlight">
                            <strong>Payoff:</strong> ${new Date(Date.now() + currentDetails.months * 30 * 24 * 60 * 60 * 1000).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                        </div>
                    </div>
                    
                    <div class="card">
                        <div class="card-title">🔄 Refinance (Base)</div>
                        <div class="metric">
                            <span class="metric-label">Monthly Payment</span>
                            <span class="metric-value">${formatCurrency(newMonthlyPayment)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Months</span>
                            <span class="metric-value">${newTerm * 12}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Interest</span>
                            <span class="metric-value">${formatCurrency(newDetails.totalInterest)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Cost (+ closing)</span>
                            <span class="metric-value">${formatCurrency(newDetails.totalPayments + closingCosts)}</span>
                        </div>
                        ${newDetails.totalPayments + closingCosts > currentDetails.totalPayments ? 
                            `<div class="warning">⚠️ Costs ${formatCurrency((newDetails.totalPayments + closingCosts) - currentDetails.totalPayments)} more overall</div>` :
                            `<div class="success">✓ Saves ${formatCurrency(currentDetails.totalPayments - (newDetails.totalPayments + closingCosts))} overall</div>`
                        }
                    </div>
                    
                    ${extraPayment > 0 ? `
                    <div class="card">
                        <div class="card-title">💰 Refinance + Extra Payment</div>
                        <div class="metric">
                            <span class="metric-label">Total Payment</span>
                            <span class="metric-value">${formatCurrency(newMonthlyPayment + extraPayment)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Payoff Months</span>
                            <span class="metric-value">${Math.round(newDetailsWithExtra.months)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Interest</span>
                            <span class="metric-value">${formatCurrency(newDetailsWithExtra.totalInterest)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Cost (+ closing)</span>
                            <span class="metric-value">${formatCurrency(newDetailsWithExtra.totalPayments + closingCosts)}</span>
                        </div>
                        <div class="success">
                            ✓ Saves ${formatCurrency(currentDetails.totalPayments - (newDetailsWithExtra.totalPayments + closingCosts))} vs current<br>
                            ✓ Pays off ${Math.round((currentDetails.months - newDetailsWithExtra.months) / 12 * 10) / 10} years earlier
                        </div>
                    </div>
                    ` : ''}
                    
                    <div class="card">
                        <div class="card-title">🚀 Apply Savings to Principal</div>
                        <div class="metric">
                            <span class="metric-label">Total Payment</span>
                            <span class="metric-value">${formatCurrency(newMonthlyPayment + monthlySavings)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Payoff Months</span>
                            <span class="metric-value">${Math.round(savingsAsExtra.months)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Interest</span>
                            <span class="metric-value">${formatCurrency(savingsAsExtra.totalInterest)}</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Total Cost (+ closing)</span>
                            <span class="metric-value">${formatCurrency(savingsAsExtra.totalPayments + closingCosts)}</span>
                        </div>
                        <div class="success">
                            ✓ Saves ${formatCurrency(currentDetails.totalPayments - (savingsAsExtra.totalPayments + closingCosts))} total<br>
                            ✓ Pays off ${Math.round((currentDetails.months - savingsAsExtra.months) / 12 * 10) / 10} years earlier
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('results').innerHTML = resultsHTML;
        }
        
        // Calculate on page load
        window.onload = function() {
            calculate();
        };
    </script>
</body>
</html>
